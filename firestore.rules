rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.role in ['manager', 'operator', 'admin', 'viewer'];
      allow update: if isOwner(userId)
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(userId);
    }

    // --- Disruptions Collection ---
    match /disruptions/{disruptionId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id is string
        && request.resource.data.severityPercent is number
        && request.resource.data.severityPercent >= 0
        && request.resource.data.severityPercent <= 100;
      allow update: if isSignedIn()
        && (resource.data.userId == request.auth.uid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isResolved']));
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // --- Recovery Executions Collection ---
    match /recovery_executions/{executionId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.recoveryCostUsd is number
        && request.resource.data.planId is string;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // --- Autonomous Agent Activity Audit Logs ---
    match /audit_logs/{logId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.agentId is string
        && request.resource.data.actionTaken is string;
      allow update: if false; // immutable audit log
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // --- Company Intelligence Dossiers (Pulled by Agent) ---
    match /company_intelligence/{intelligenceId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.companyName is string;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // --- Digital Twin Suppliers Collection ---
    match /suppliers/{supplierId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.id is string
        && request.resource.data.name is string;
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // --- Digital Twin Network State ---
    match /digital_twin_state/{stateId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}
